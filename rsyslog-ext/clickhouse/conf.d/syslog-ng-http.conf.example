# syslog-ng -> ClickHouse через штатный модуль http (destination http()).
#
# Альтернатива rsyslog + omclickhouse (см. omclickhouse.conf.example) на тот
# случай, когда журнал собирает syslog-ng. Собирать ничего не нужно: модули
# http и json-plugin входят в syslog-ng-core из репозитория astra
# (3.19.1, `syslog-ng --version` -> Available-Modules: ...,http,...,json-plugin,...).
#
# Скопировать в /etc/syslog-ng/conf.d/ (без .example), поправить url и пароль,
# проверить `syslog-ng -s -f /etc/syslog-ng/syslog-ng.conf` и перезапустить.
#
# Таблица заводится заранее — та же, что у omclickhouse, так что оба варианта
# пишут в одно место и взаимозаменяемы:
#
#   CREATE DATABASE IF NOT EXISTS rsyslog;
#   CREATE TABLE IF NOT EXISTS rsyslog.SystemEvents (
#       severity  UInt8,
#       facility  UInt8,
#       timestamp DateTime,
#       hostname  LowCardinality(String),
#       tag       String,
#       message   String
#   ) ENGINE = MergeTree
#   PARTITION BY toYYYYMM(timestamp)
#   ORDER BY (hostname, timestamp);
#
# Чем отличается от omclickhouse: тот собирает текстовый INSERT ... VALUES и
# экранирует значения сам (и на STDSQL спотыкается об обратный слеш), а здесь
# тело запроса — JSONEachRow, экранированием занимается format-json. Кавычки,
# слеши и многострочные сообщения проблемой не являются.

# Что приходит и что оказывается в таблице (снято с работающей связки).
#
# Строка syslog на входе:
#   <86>Sep  2 10:30:00 web01 sshd[2145]: Accepted publickey for admin from 10.0.0.7 port 51234 ssh2
#
# Тело запроса, которое syslog-ng отправит в ClickHouse (по объекту на строку,
# склеены переводом строки — это и есть JSONEachRow):
#   {"timestamp":1788345000,"tag":"sshd","severity":6,"message":"Accepted publickey for admin from 10.0.0.7 port 51234 ssh2","hostname":"web01","facility":10}
#
# Порядок ключей format-json не сохраняет — для JSONEachRow это неважно,
# ClickHouse сопоставляет поля с колонками по имени.
#
# Строка в rsyslog.SystemEvents:
#   severity  = 6                       <86> = 10*8 + 6, то есть authpriv.info
#   facility  = 10
#   timestamp = 2026-09-02 10:30:00     время ИЗ строки syslog
#   hostname  = "web01"                 из строки, благодаря keep-hostname(yes)
#   tag       = "sshd"
#   message   = "Accepted publickey for admin from 10.0.0.7 port 51234 ssh2"
#
# Ещё одна, <27> = 3*8 + 3, то есть daemon.err:
#   <27>Sep  2 10:30:05 web01 nginx: 10.0.0.7 - - [02/Sep/2026:10:30:05 +0300] "GET /v1/orders HTTP/1.1" 500 217
#
#   severity = 3, facility = 3, hostname = "web01", tag = "nginx",
#   message  = "10.0.0.7 - - [02/Sep/2026:10:30:05 +0300] \"GET /v1/orders HTTP/1.1\" 500 217"
#
# ОТЛИЧИЕ ОТ omclickhouse на той же строке и в той же таблице:
#   syslog-ng    tag = "sshd"          message без ведущего пробела
#   omclickhouse tag = "sshd[2145]:"   message с ведущим пробелом
# $PROGRAM у syslog-ng — только имя программы, без pid и двоеточия. Если нужен
# полный тег как у rsyslog, вместо $PROGRAM берётся $MSGHDR.

@version: 3.19
@include "scl.conf"

options {
    # без этого syslog-ng подставит в $HOST имя своей машины вместо
    # имени из принятой строки syslog
    keep-hostname(yes);
    chain-hostnames(no);
    use-dns(no);
};

source s_local { system(); internal(); };

# приём с других машин
# source s_net { network(transport("tcp") port(514)); };

destination d_clickhouse {
    http(
        # запрос ClickHouse едет в query string, пробелы — %20
        url("http://clickhouse.example.ru:8123/?query=INSERT%20INTO%20rsyslog.SystemEvents%20FORMAT%20JSONEachRow")
        method("POST")
        user("default")
        password("secret")
        headers("Content-Type: application/x-ndjson")

        # одно сообщение — один JSON-объект; при батчинге они склеиваются
        # переводом строки (delimiter() по умолчанию "\n"), это и есть
        # формат JSONEachRow.
        # ВАЖНО: макрос внутри приведения типа пишется БЕЗ кавычек —
        # int64("$LEVEL_NUM") молча даёт 0, а int64($LEVEL_NUM) даёт число.
        # Строковые значения, наоборот, в кавычках.
        # timestamp отдаётся числом unix-времени: ClickHouse принимает его
        # в колонку DateTime как есть.
        body("$(format-json
                severity=int64($LEVEL_NUM)
                facility=int64($FACILITY_NUM)
                timestamp=int64($S_UNIXTIME)
                hostname=\"$HOST\"
                tag=\"$PROGRAM\"
                message=\"$MSG\")")

        # пачками: что наберётся первым, то и отправит
        batch-lines(1000)
        batch-bytes(4Mb)
        batch-timeout(2000)
        workers(4)

        timeout(10)
        retries(3)

        # очередь на диске: ClickHouse может быть недоступен, журнал ждать
        # не должен. При reliable(no) размер памяти задаётся в сообщениях
        # (mem-buf-length), а не в байтах — mem-buf-size здесь игнорируется
        persist-name("clickhouse")
        log-fifo-size(100000)
        disk-buffer(
            mem-buf-length(20000)
            disk-buf-size(1Gb)
            reliable(no)
            dir("/var/lib/syslog-ng")
        )

        # HTTPS: url("https://clickhouse.example.ru:8443/?query=...")
        # peer-verify() принимает только yes/no, старое required-trusted
        # эта версия не понимает
        # tls(
        #     peer-verify(yes)
        #     ca-file("/etc/pki/tls/certs/clickhouse-ca.crt")
        #     cert-file("/etc/pki/tls/certs/syslog-ng.crt")
        #     key-file("/etc/pki/tls/private/syslog-ng.key")
        # )
    );
};

log {
    source(s_local);
#   source(s_net);
    destination(d_clickhouse);
};
