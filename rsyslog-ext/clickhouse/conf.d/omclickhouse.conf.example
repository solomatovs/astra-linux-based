# omclickhouse: отправка журнала в ClickHouse по HTTP.
# Скопировать в /etc/rsyslog.d/ (без .example), поправить server/pwd и
# перезапустить rsyslog. Таблица заводится заранее — модуль её не создаёт:
#
#   CREATE DATABASE IF NOT EXISTS rsyslog;
#   CREATE TABLE IF NOT EXISTS rsyslog.SystemEvents (
#       severity  UInt8,
#       facility  UInt8,
#       timestamp DateTime,
#       hostname  LowCardinality(String),
#       tag       String,
#       message   String
#   ) ENGINE = MergeTree
#   PARTITION BY toYYYYMM(timestamp)
#   ORDER BY (hostname, timestamp);

# Что приходит и что оказывается в таблице (снято с работающей связки).
#
# Строка syslog на входе:
#   <86>Sep  2 10:30:00 web01 sshd[2145]: Accepted publickey for admin from 10.0.0.7 port 51234 ssh2
#
# Строка в rsyslog.SystemEvents (значения показаны в кавычках, чтобы был виден
# ведущий пробел в message):
#   severity  = 6                       <86> = 10*8 + 6, то есть authpriv.info
#   facility  = 10
#   timestamp = 2026-09-02 10:30:00     время ИЗ строки syslog
#   hostname  = "web01"                 тоже из строки
#   tag       = "sshd[2145]:"           %syslogtag% — вместе с pid и двоеточием
#   message   = " Accepted publickey for admin from 10.0.0.7 port 51234 ssh2"
#                ^ %msg% всегда начинается с пробела после двоеточия тега.
#                  Если он мешает, в шаблоне пишется %msg:2:$%
#
# Ещё одна, <27> = 3*8 + 3, то есть daemon.err:
#   <27>Sep  2 10:30:05 web01 nginx: 10.0.0.7 - - [02/Sep/2026:10:30:05 +0300] "GET /v1/orders HTTP/1.1" 500 217
#
#   severity = 3, facility = 3, hostname = "web01", tag = "nginx:",
#   message  = " 10.0.0.7 - - [02/Sep/2026:10:30:05 +0300] \"GET /v1/orders HTTP/1.1\" 500 217"
#
# То есть сюда попадает то же, что и в /var/log/messages: разбором занимается
# сам rsyslog, действие только раскладывает разобранное по колонкам.

module(load="omclickhouse")

# Шаблон по умолчанию (" StdClickHouseFmt") пишет ровно в таблицу выше, но
# экранирует по STDSQL — только кавычку. ClickHouse понимает и обратный слеш,
# поэтому сообщение с '\' на конце ломает INSERT, и пачка теряется молча.
# Отсюда свой шаблон с option.sql="on": он экранирует и слеш тоже.
template(name="chInsert" type="string" option.sql="on"
    string="INSERT INTO rsyslog.SystemEvents (severity, facility, timestamp, hostname, tag, message) VALUES (%syslogseverity%, %syslogfacility%, '%timereported:::date-unixtimestamp%', '%hostname%', '%syslogtag%', '%msg%')")

*.* action(
    type="omclickhouse"
    server="clickhouse.example.ru"
    port="8123"
    user="default"
    pwd="secret"
    template="chInsert"

    # пачками: строки VALUES склеиваются, пока не наберётся maxbytes
    bulkmode="on"
    maxbytes="10m"

    # HTTPS включён по умолчанию (usehttps=on, allowunsignedcerts=on) —
    # для сервера без TLS его надо выключить явно.
    # Корневые сертификаты берутся системные, tls.cacert — если свой CA
    usehttps="off"
    # tls.cacert="/etc/pki/tls/certs/clickhouse-ca.crt"
    # tls.mycert="/etc/pki/tls/certs/rsyslog.crt"
    # tls.myprivkey="/etc/pki/tls/private/rsyslog.key"

    # таймауты в миллисекундах: проверка живости и сама вставка
    healthchecktimeout="3500"
    timeout="0"

    # что не удалось вставить — в файл, иначе теряется молча
    errorfile="/var/log/rsyslog-clickhouse-fail.log"

    # очередь на диске: ClickHouse может быть недоступен, журнал ждать не должен
    queue.type="linkedlist"
    queue.filename="omclickhouse"
    queue.maxdiskspace="1g"
    queue.saveonshutdown="on"
    action.resumeRetryCount="-1"
)
