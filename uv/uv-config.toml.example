# ============================================================
# Системный конфиг uv для закрытого контура (nexus).
# Реальный файл — artifacts/uv-config.toml, копируется образом
# в /etc/uv/uv.toml (системный уровень: действует на всех
# пользователей, перекрывается ~/.config/uv/uv.toml и uv.toml
# самого проекта).
#
# По умолчанию файла нет — uv ходит в pypi.org и github.com.
#
# Пример замены индекса на nexus:
#
#   [[index]]
#   name = "nexus"
#   url = "https://nexus.internal.example.com/repository/pypi/simple"
#   default = true
#
#   # не ходить в pypi.org даже за отсутствующим пакетом
#   index-strategy = "first-index"
#
#   # закрытый контур: свой CA
#   # (или переменной окружения SSL_CERT_FILE=/usr/local/share/ca-certificates/ca-chain.crt)
#   native-tls = true
#
# Зеркало интерпретаторов для `uv python install`
# (uv тянет python-build-standalone с github.com):
#   ENV UV_PYTHON_INSTALL_MIRROR=https://nexus.internal.example.com/repository/python-build-standalone
#
# Полностью запретить сеть:
#   ENV UV_OFFLINE=1
#
# Проверить в образе:
#   docker run --rm --entrypoint uv dmp/uv:<версия> python list
# ============================================================
