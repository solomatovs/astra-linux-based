# ============================================================
# Учётные данные poetry для образа dmp/poetry.
#
# Реальный файл кладётся рядом с Dockerfile под именем
# poetry-auth.toml (он в .gitignore) и попадает в образ как
# /etc/pypoetry/auth.toml с правами 600.
#
# ВНИМАНИЕ: пароль в auth.toml лежит открытым текстом внутри
# слоя образа — вшивать его имеет смысл только в приватный
# образ закрытого контура. Альтернатива без записи в образ —
# переменные окружения на запуске контейнера:
#   POETRY_HTTP_BASIC_<ИМЯ_ИСТОЧНИКА>_USERNAME
#   POETRY_HTTP_BASIC_<ИМЯ_ИСТОЧНИКА>_PASSWORD
# (имя источника заглавными, дефисы -> подчёркивания)
#
# keyring в образе не используется: без DBus/секретницы он всё
# равно недоступен, poetry падает обратно на этот файл.
# ============================================================

# [http-basic.nexus]
# username = "svc-build"
# password = "..."

# # токен вместо логина/пароля (например, для publish):
# [pypi-token]
# nexus = "..."
